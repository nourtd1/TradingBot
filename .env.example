# =================================================================
#  SentiTrade - secrets. MODELE uniquement.
#
#  Le vrai fichier est :  %USERPROFILE%\.tradingbot\.env
#  (cree par INSTALLER.bat, hors du dossier du projet)
#
#  REGLES :
#   - Phase actuelle : compte DEMO uniquement.
#   - Ne jamais partager ce fichier ni le coller dans une conversation.
#   - Le bot peut aussi se brancher sur le terminal MT5 deja ouvert et
#     connecte : dans ce cas, les trois champs MT5 peuvent rester vides.
# =================================================================

# demo (par defaut) ; real exigera une action explicite plus tard
MODE_COMPTE=demo

# Compte MetaTrader 5 (numero, mot de passe, serveur du broker)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optionnel : chemin de terminal64.exe si plusieurs MT5 sont installes
MT5_TERMINAL_PATH=

# Alertes (optionnel) : Telegram et/ou Discord
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
